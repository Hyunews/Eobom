{
  "name": "eobom-backend",
  "version": "1.0.0",
  "description": "이어봄 (Eobom) 디지털 엔딩 & 웰다잉 플랫폼 백엔드 API 서버",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "node --require ts-node/register/transpile-only --test src/services/willRequirements.test.ts src/utils/operatingHours.test.ts src/utils/kst.test.ts tests/db-guard.test.ts tests/auth-boundary.test.ts tests/consent.test.ts tests/demo-login.test.ts tests/admin-login-lock.test.ts tests/ops-log.test.ts tests/created-at-kst.test.ts tests/updated-at-kst.test.ts tests/cors-ratelimit.test.ts tests/deletion-grace-guard.test.ts tests/heavy-queue.test.ts tests/ocr-upload.test.ts tests/heavy-job-http.test.ts tests/retention-purge.test.ts tests/memorial-lifecycle-db.test.ts src/services/heavyJob.test.ts",
    "test:db:migrate": "node --require ts-node/register/transpile-only tests/migrate-test-db.ts",
    "purge": "node --require ts-node/register/transpile-only prisma/destroy-farewell-media.ts",
    "report:heavy": "node --require ts-node/register/transpile-only prisma/report-heavy-jobs.ts",
    "purge:confirm": "node --require ts-node/register/transpile-only prisma/destroy-farewell-media.ts --confirm",
    "studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "seed:admin": "ts-node prisma/seed-admin.ts",
    "sync:kakao-funeral": "ts-node prisma/sync-kakao-funeral.ts",
    "import:facility-csv": "ts-node prisma/import-facility-csv.ts",
    "import:facility-mohw": "ts-node prisma/import-facility-mohw.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@prisma/client": "^5.10.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.0",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-kakao": "^1.0.1",
    "passport-naver-v2": "^2.0.8",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/heic-convert": "^2.1.1",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.24",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-kakao": "^1.0.3",
    "csv-parse": "^7.0.2",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
