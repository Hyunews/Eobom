PORT=5000
# 로그인 완료 후 돌려보낼 프론트 주소의 기본값(폴백)이다. LAN IP로 접속해 로그인한 경우
# (예: 폰으로 http://192.168.x.x:5173 접속) 백엔드가 요청 Referer로 그 주소를 자동 감지해
# 이 값 대신 사용한다 — 사설 IP·localhost + 5173 포트만 신뢰하며, 그 외(배포 도메인 등)는
# 항상 이 FRONTEND_URL 값을 쓴다. 프로덕션에서는 실제 배포 주소로 반드시 채울 것.
FRONTEND_URL=http://localhost:5173
# CORS 허용 출처(00-42 §10) — 쉼표로 구분. 비워 두면 기본값(https://eobom.vercel.app + localhost·127.0.0.1의 5173 포트 http·https)을 쓴다.
# 값을 쓰면 기본 목록을 **대체**한다(합치지 않음). 운영에서 localhost까지 막으려면 Render 환경변수에 CORS_ORIGINS=https://eobom.vercel.app.
# 개발(NODE_ENV≠production)에서는 위와 별개로 사설망 IP(192.168.x.x 등)의 5173 포트도 허용한다 — 폰으로 LAN 접속해 시험하는 용도.
# Vercel 미리보기 주소(eobom-xxxx.vercel.app)는 기본 목록에 없다 — 미리보기에서 API를 부르려면 여기에 추가.
# CORS_ORIGINS=
# 로컬·운영 서로 다른 긴 무작위 값. 비어 있으면 서버가 시작되지 않는다(src/config/jwt.ts).
JWT_SECRET=
# 🔴 .env의 DATABASE_URL은 항상 로컬이다. 운영 주소로 바꿔 쓰지 않는다(주석을 번갈아 풀기 금지).
# 운영은 정해진 통로로만: migrate-prod.ps1 · backup-db.ps1 -Target prod · npm run report:heavy -- --target prod
# (운영 주소는 아래 BACKUP_DATABASE_URL). 절차 → .harness/db-safety.md §2-2
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eobom_db?schema=public"
# 회귀 테스트 전용 DB(npm test) — 로컬 Docker 안의 별도 DB. 🔴 이름이 _test로 끝나고 localhost여야 하며,
# 아니면 테스트가 시작 자체를 거부한다(tests/helpers/dbGuard.ts). DATABASE_URL로 폴백하지 않는다. 절차 → tests/README.md
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eobom_test?schema=public"

# Partner(사업자) 정산 계좌 등 민감 필드 암호화 키(AES-256-GCM). 임의 길이 문자열 가능(sha256으로 정규화됨).
# 운영 배포 시 반드시 새로 생성해서 교체할 것 — 이 값이 유출되면 저장된 정산 계좌 전부 복호화 가능.
SETTLEMENT_ENCRYPTION_KEY=change_this_to_a_long_random_string_in_each_environment

# 06(엔딩노트·유족 메시지) 전용 암호화 키(AES-256-GCM). 정산 계좌 키와 분리한다(06-04 §13 #4)
# — 정산 계좌와 같은 키를 쓰면 한쪽 유출이 곧 양쪽 유출이 된다. SETTLEMENT_ENCRYPTION_KEY와 같은
# 방식으로 임의 길이 문자열이면 되고 sha256으로 정규화된다.
# 🔴 로컬과 운영에 서로 다른 값을 넣을 것. 🔴 운영 키를 잃으면 유언·편지를 영영 복호화할 수 없다.
ENDING_NOTE_ENCRYPTION_KEY=change_this_to_a_long_random_string_in_each_environment

# 가족지정 전화번호 중복방지 해시(HMAC-SHA256) 전용 키 — docs 00-33 §4.2. 예전에는
# SETTLEMENT_ENCRYPTION_KEY에서 파생해 정산 키를 바꾸면 가족지정 중복방지(@@unique)가 조용히
# 깨졌다. 32자 이상 랜덤 문자열 권장(00-33 §7.2 — 짧으면 로컬은 경고, 운영은 기동 차단).
# 🔴 이 키를 바꾸면 기존 phoneHash 전체가 안 맞게 된다 — 재해시는 prisma/rotate-keys.ts로
#    별도 실행(db-safety.md 게이트), 이 값을 단독으로 바꾸지 말 것.
HASH_INDEX_KEY=change_this_to_a_long_random_string_in_each_environment

# 운영 DB 백업 전용(.harness/tools/backup-db.ps1) — DIRECT_URL과 별개로 둔다. DIRECT_URL은
# 로컬 Docker DB를 가리키므로 이 값이 없으면 운영 DB를 백업할 방법이 없다.
# 🔴 Supabase Session pooler(5432)여야 한다 — Direct(db.[ref].supabase.co)는 IPv6 전용이라
#    Docker에서 해석 실패하고, Transaction(:6543)은 pg_dump가 실패한다.
# 유저명은 postgres.[project-ref] 형태. 자세한 함정은 systems.md §4.
BACKUP_DATABASE_URL=

# OAuth 콜백 URL은 https다 — 2026-08-07 mkcert 도입 후 백엔드가 인증서 존재 시 HTTPS만 서빙한다
# (server.ts). http로 두면 카카오 인증 완료 후 리다이렉트가 TLS 포트에 평문으로 들어가 빈 응답
# (ERR_EMPTY_RESPONSE)이 난다 — 2026-08-10 실제 장애. 이 값과 각 OAuth 콘솔에 등록된 Redirect URI가
# 정확히 일치해야 한다(→ .harness/systems.md §1).

# Kakao OAuth
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_CALLBACK_URL=https://localhost:5000/api/auth/kakao/callback

# Naver OAuth
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=https://localhost:5000/api/auth/naver/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://localhost:5000/api/auth/google/callback

# STT Ⓐ 파일 업로드 — NCP CLOVA Speech(장문 인식, docs 06-04 §6.4-11). Invoke URL이 도메인
# 식별자를 이미 품고 있어 별도 Client ID가 없다 — 인증은 Secret Key 헤더 하나로 한다.
CLOVA_SPEECH_INVOKE_URL=https://clovaspeech-gw.ncloud.com/external/v1/your-domain-id
CLOVA_SPEECH_SECRET=your_clova_speech_secret_key
# 기능 플래그. 기본값은 반드시 false — 배선은 켜두되(§6.4-9-8-3), ⓐ이용자 동의화면·
# ⓑprovider 교체·ⓒ계약 중 하나가 서기 전에는 실사용자에게 업로드 버튼을 노출하지 않는다.
CLOVA_STT_ENABLED=false

# 유언장 사진 인식(OCR) — NCP CLOVA OCR(General, 글자 추출, docs 06-06 §4·§5). Invoke URL +
# Secret Key 헤더 하나로 인증한다(STT와 같은 방식, 헤더 이름만 다르다).
# 콘솔 Invoke URL 그대로 붙여 넣기(끝의 /general 포함 가능 — 없으면 코드가 붙인다).
CLOVA_OCR_INVOKE_URL=https://xxxxxxxxxx.apigw.ntruss.com/custom/v1/xxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOVA_OCR_SECRET=your_clova_ocr_secret_key
# 기능 플래그. 기본값 false — CLOVA_STT_ENABLED와 같은 취지.
CLOVA_OCR_ENABLED=false

# Cloudflare R2 (docs 00-11 §5.4). S3 호환이라 @aws-sdk/client-s3를 그대로 쓴다.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# 버킷별 토큰 3개로 분리(§5.4-6-1). 접미사로 구분한다 — 공용 1개로 합치지 않는다.
R2_ACCESS_KEY_ID_VOICE=
R2_SECRET_ACCESS_KEY_VOICE=
R2_ACCESS_KEY_ID_MEDIA=
R2_SECRET_ACCESS_KEY_MEDIA=
R2_ACCESS_KEY_ID_DOCS=
R2_SECRET_ACCESS_KEY_DOCS=
# 🔴 기본값은 개발용(-dev) — 로컬이 운영 버킷에 붙지 않게(§5.4-6-3). 운영 버킷명은 Render 환경변수에만 적는다.
R2_BUCKET_FAREWELL_VOICE=eobom-farewell-voice-dev
R2_BUCKET_MEMORIAL_MEDIA=eobom-memorial-media-dev
R2_BUCKET_BIZ_DOCS=eobom-biz-docs-dev
# 기능 플래그. 기본값 false — CLOVA_STT_ENABLED와 같은 취지(06-04 §6.4-9-8-3).
# 버킷·토큰이 서 있어도 이 값이 false면 업로드 경로를 열지 않는다.
R2_ENABLED=false

# 유언장 사진 보관(docs 06-06 §5-2 · 00-11 §5.4-6) — 전용 버킷·전용 토큰(음성과 섞지 않는다). 로컬은 -dev 버킷만.
# 스위치 기본 false. 켜려면 아래 3개가 모두 있어야 한다(R2_ENDPOINT는 위 값을 같이 쓴다).
R2_WILL_ACCESS_KEY_ID=
R2_WILL_SECRET_ACCESS_KEY=
R2_WILL_BUCKET=eobom-will-photo-dev
R2_WILL_ENABLED=false

# 추모관 통지(만료 통지·파기 30일 전 재확인) 발송 기능 플래그 — docs 00-20 §8.1-3. 기본값 false, CLOVA_STT_ENABLED와 같은 취지.
# 🔴 발송 업체는 아직 붙이지 않았다(업체·보내는 도메인·알림톡 발신 프로필은 사람이 정한다). true로 켜도 업체가 없으면 "통지 실패"로 기록되고,
# 재확인 통지가 실패한 동결 추모관은 파기되지 않는다(동결 유지).
EMAIL_ENABLED=false
ALIMTALK_ENABLED=false
