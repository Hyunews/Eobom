# Kakao Maps JS API Key
VITE_KAKAO_MAP_KEY=your_kakao_javascript_api_key_here

# Kakao Share JS SDK Key (docs 07-03 §3.2 — 지도 SDK와 별개 스크립트/용도).
# 카카오 디벨로퍼 > 플랫폼 > Web 사이트 도메인 등록 후 발급되는 JavaScript 키.
VITE_KAKAO_JS_KEY=your_kakao_javascript_api_key_here

# 백엔드 API 주소 override.
# 🔴 로컬 .env에서는 비워둔다 — 그래야 config.ts가 "접속한 호스트 + 5000번 포트"로
#    폴백해 로컬 백엔드(→ 로컬 Docker DB)를 본다. LAN IP로 접속해도 동작한다.
#    여기에 프로덕션 주소를 넣으면 로컬 개발이 프로덕션 DB(Supabase)를 건드린다.
#
# 프로덕션 값은 Vercel 대시보드 > Settings > Environment Variables 에만 넣는다:
#    VITE_BACKEND_URL = https://eobom-backend.onrender.com
# ⚠️ Vite는 빌드 시점에 값을 굽는다 — 추가·변경 후 반드시 재배포해야 반영된다.
#
# 🔴 임시 터널(trycloudflare.com 등) 주소를 넣지 말 것 — 재시작 시 주소가 바뀌어
#    조용히 죽는다(2026-08-20 실제 발생, .harness/systems.md §2).
