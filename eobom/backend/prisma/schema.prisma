// DATABASE_URL = 런타임 연결. Supabase에서는 커넥션 풀러(PgBouncer) 주소를 쓴다.
// DIRECT_URL   = 마이그레이션 전용 직결. 🔴 풀러로는 `prisma migrate`가 실패한다
//                (트랜잭션 모드에서 prepared statement를 못 쓴다). 이게 없으면
//                `npm start`의 `prisma migrate deploy`가 죽어 서버가 아예 안 뜬다.
//
// 로컬(Docker)에서는 풀러가 없으므로 둘 다 같은 값을 넣으면 된다.
// ⚠️ DIRECT_URL이 비어 있으면 Prisma가 오류를 낸다 — .env에 반드시 둘 다 둘 것.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 유저 마스터 (B2C 일반 회원) — Partner/Expert/Admin과는 완전히 분리된 별도 인증 체계
model User {
  id                  String               @id @default(uuid()) // 고유 식별자(UUID)
  email               String?              @unique // 유저 대표 이메일 (유니크)
  name                String // 유저 이름 / 닉네임
  profileImage        String? // 대표 프로필 이미지 URL
  role                String               @default("USER") // 'USER', 'EXPERT', 'ADMIN'
  refreshToken        String? // JWT Refresh Token
  accounts            SocialAccount[] // 연동된 소셜 계정 목록
  facilityReviews     FacilityReview[] // 이 유저가 작성한 시설 리뷰 목록
  leads               Lead[] // docs/01_.../01-05 — 이 유저가 남긴 문의/견적요청 리드
  consultRequests     ConsultRequest[] // docs/02_.../02-03 — 이 유저가 남긴 전문가 상담 신청
  digitalCleanupItems DigitalCleanupItem[] // docs 04-01 §4.3 — 디지털 정리 진행 항목
  memorials           Memorial[] // docs 05-01 §3.5 — 개설한 추모관
  memorialTributes    MemorialTribute[] // 남긴 헌화
  memorialGuestbooks  MemorialGuestbook[] // 남긴 방명록
  memorialPhotos      MemorialPhoto[] // 업로드한 추모 사진
  obituaries          Obituary[] // docs 07-03 §4.2 — 개설한 부고장
  familyDesignations  FamilyDesignation[] // docs 00-27 §4 — 생전 지정한 가족(제3자)
  endingNote          EndingNote? // docs 06-05 §6.1 — 1인 1건. 개봉 상태의 유일한 소유자(§3.2·§3.3)

  // 00-28 회원 프로필 — 전부 선택(§3.1). 신청 스냅샷과 별개다(§2)
  contactPhone      String?   // 숫자만 정규화 저장(utils/phone.ts) — Partner·Expert와 동일 규칙
  phoneVerifiedAt   DateTime? // SMS 본인확인 도입 전까지 항상 null(§8 Phase 3)
  addressZonecode   String?   // 우편번호
  addressRoad       String?   // 도로명 주소 — 지역 기반 안내용(§3.3)
  addressDetail     String?   // 동·호수 — 방문 서비스에서만 필요(§3.3)
  contactTimePref   String?   // ANYTIME | MORNING | AFTERNOON | EVENING
  marketingAgreedAt DateTime? // null이면 미동의. 철회 시 다시 null
  profileUpdatedAt  DateTime? // 프로필을 실제로 채운 시각(가입 updatedAt과 구분)

  // 가입 시점 필수 동의 — 기존엔 회원가입(소셜 로그인) 흐름에 동의 절차 자체가 없었다(2026-08-24
  // 확인). LoginModal.tsx가 필수 체크 2개를 통과해야 소셜 로그인 버튼을 활성화하고, OAuth state에
  // 실어보낸 동의 여부를 콜백에서 신규 User 생성 시점에만 여기 스탬프한다(기존 유저 재로그인·
  // 계정 추가연동은 새로 동의를 받지 않음 — 최초 가입 때 이미 받았으므로).
  termsAgreedAt   DateTime? // 서비스 이용약관 동의 시각(필수) — 신규 가입이면 항상 채워짐
  privacyAgreedAt DateTime? // 개인정보 수집·이용 동의 시각(필수) — 신규 가입이면 항상 채워짐

  createdAt           DateTime             @default(now()) // 가입 일시
  updatedAt           DateTime             @updatedAt // 최종 수정 일시
}

// 생전 가족지정 — 00-27. 지정자가 아직 살아 있으므로 Deceased가 아니라 User에 붙는다(§1.2)
model FamilyDesignation {
  id              String    @id @default(uuid())
  userId          String                        // 지정한 본인(생전)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String                        // 가족 성함
  phoneEnc        String                        // 🔴 AES-256-GCM 암호문(불변식 2)
  phoneHash       String                        // 중복 지정 방지용 인덱스 — §4.1
  emailEnc        String?                       // 선택. 연락수단 이중화(§5 ⑥)
  relationship    String                        // SPOUSE|CHILD|PARENT|SIBLING|OTHER
  relationshipEtc String?                       // OTHER일 때만
  scope           String    @default("VIEWER")  // PRIMARY | VIEWER (§6)
  priority        Int       @default(1)         // 연락 순서. ⚠️ 상속순위 아님(불변식 4)

  status          String    @default("DRAFT")   // DRAFT|PENDING|ACCEPTED|DECLINED|EXPIRED
  inviteToken     String?   @unique             // 통지 링크 토큰(Phase 2). 추측 불가
  tokenExpiresAt  DateTime?                     // 초대 링크 만료 시각. 지나면 status=EXPIRED
  notifiedAt      DateTime?                     // 통지를 보낸 시각(§2.2 ⓐ 본인 / ⓑ 사망 확인)
  acceptedAt      DateTime?                     // 가족이 수락한 시각 = 정보주체 동의 시각(§2.1)
  declinedAt      DateTime?                     // 가족이 거절한 시각. 재지정하려면 다시 통지
  acceptedUserId  String?                       // 수락한 가족의 User — 계정 연결 결과(§9)
  acceptAttempts  Int       @default(0)         // §9.1-4-3 성함 대조 오답 횟수. 5회 초과 시 토큰 잠금(재발급 필요). 입력 이름 자체는 저장하지 않는다

  lastConfirmedAt DateTime  @default(now())     // 정확도·보유기간 재확인 기준(§7)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  farewellMessages FarewellMessage[]            // docs 06-05 §6.2 — 이 수신자 앞으로 남긴 편지들
  endingNoteEntries EndingNoteEntry[]            // docs 06-04 §4.2 — 이 수신자를 지정한 엔딩노트 섹션. Phase 1은 항상 null(전원)이라 실질 데이터는 Phase 2부터
  endingNoteGrants  EndingNoteGrant[]             // docs 06-04 §4.2·§10 Phase 2 — 이 가족에게 부여된 섹션별 열람 시점

  @@unique([userId, phoneHash])                 // 같은 사람을 두 번 지정하지 못하게
  @@index([userId, status])
}

// 소셜 로그인 계정 (User 1:N) — 카카오/네이버/구글 연동 정보, 1인 다계정 연동 지원
model SocialAccount {
  id         String    @id @default(uuid()) // 고유 식별자(UUID)
  userId     String // 이 소셜 계정이 연동된 User
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // 'KAKAO', 'NAVER', 'GOOGLE'
  providerId String // 각 소셜 제공자의 고유 식별자 ID
  email      String? // 소셜 프로필상의 이메일
  createdAt  DateTime  @default(now()) // 최초 연동 일시
  unlinkedAt DateTime? // null이면 연동 중. 값이 있으면 사용자가 연동 해제한 상태(소프트 삭제) —
  // 재로그인 시 이 provider+providerId를 다시 인식해 같은 계정으로 복구하기 위해 하드 삭제하지 않음

  @@unique([provider, providerId])
}

// 시설 마스터 (장례식장 / 묘지·수목장)
model Facility {
  id           String   @id // 고유 식별자 — 소스별 규칙 있음(CSV: bongan_NNN/jayeon_NNN, 카카오: kakao_<placeId>, 수기 시드: f_*)
  name         String // 시설명
  type         String // '장례식장' | '묘지/수목장'
  location     String // 도로명 주소 (화면 표시용 — 전남광주통합특별시 등 병합 표기는 utils/address.ts 정규화 거침)
  lat          Float // 위도
  lng          Float // 경도
  phone        String? // 실데이터 수집(카카오/공공 CSV) 시 채워지는 연락처
  kakaoPlaceId String?  @unique // 카카오 로컬 API로 수집한 장례식장의 장소ID (재동기화 dedup용)
  price        String // 대표 가격 표시 문자열 (예: "950만원~")
  rating       Float    @default(0.0) // 초기 시딩값(공시 만족도 기준) — 리뷰 5건 미만일 때 노출값으로 사용
  religion     String // 수용 가능 종교 (예: '전체 종교')
  guests       String // 수용 가능 하객 규모 (예: '100~300명')
  // 파생 캐시 컬럼 — 정본은 partnerId. 클레임 승인/해지 트랜잭션 안에서만 갱신한다(docs 01-05 §3.4).
  isPartner    Boolean  @default(false) // 제휴(클레임 승인된) 시설 여부
  partnerId    String? // 클레임 승인된 사업자 (없으면 비제휴)
  partner      Partner? @relation(fields: [partnerId], references: [id])
  tags         String[] @default([]) // 표시용 태그 배열 — 분류 가능한 값(공설/사설 등)만 frontend TAG_CATALOG로 필터링됨(docs 01-06)
  amenities    String[] @default([]) // 부대시설 목록 (예: 식당/매점/주차장/유족대기실/장애인편의시설)
  images       String[] @default([]) // 파트너가 BizDashboard에서 업로드한 시설 사진 URL 목록 (2026-08-10)
  createdAt    DateTime @default(now()) // 레코드 생성 일시
  updatedAt    DateTime @updatedAt // 최종 수정 일시

  reviews FacilityReview[] // 이 시설에 달린 리뷰 목록
  claims  FacilityClaim[] // 이 시설에 대한 소유권 클레임 이력
  leads   Lead[] // 이 시설로 들어온 리드(문의/견적요청/답사예약) 목록

  @@index([partnerId])
}

// 시설 리뷰
model FacilityReview {
  id         String   @id @default(uuid()) // 고유 식별자(UUID)
  facilityId String // 리뷰 대상 시설
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId     String // 리뷰 작성자
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Float // 별점 (1~5)
  content    String // 리뷰 본문
  createdAt  DateTime @default(now()) // 작성 일시

  @@unique([facilityId, userId]) // 1인 1리뷰 (실제 답사완료 인증 체계 없어 로그인 유저 단위로 단순화)
}

// ─────────────────────────────────────────────────────────────────
// 장사시설 사업자 회원 + 리드 수수료 정산 인프라
// docs/01_장사시설_매칭/01-05_장사시설_사업자회원_및_리드_수수료_정산_명세서.md
// 2026-08-10 대표 지시 기반. §는 위 문서의 섹션 번호를 가리킨다.
// ─────────────────────────────────────────────────────────────────

// 사업자 (법인격 단위) — B2C User와 완전 분리 (§3.1)
model Partner {
  id               String  @id @default(uuid()) // 고유 식별자(UUID)
  email            String  @unique // 로그인 ID
  passwordHash     String // bcrypt 해시 (평문 저장 금지)
  refreshTokenHash String? // 발급된 refresh token의 sha256 해시 (회전·재사용 탐지용, §6.1)

  partnerType String @default("FUNERAL_FACILITY") // FUNERAL_FACILITY(01 장사시설) | ESTATE_CLEANUP(03 유품 수거)
  // 기본값을 01로 두어 기존 데이터·기존 흐름이 그대로 유효하다 — 마이그레이션 무해 (03-02 §3.1)

  bizRegNo      String  @unique // 사업자등록번호 (하이픈 제거 10자리)
  companyName   String // 상호
  ownerName     String // 대표자명
  contactName   String // 담당자명
  contactPhone  String // 담당자 연락처 (숫자만 정규화 저장, utils/phone.ts)
  bizLicenseUrl String? // 사업자등록증 사본 (비공개 스토리지, §7.4)

  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED (§3.2)
  rejectReason String? // 반려 사유 (status=REJECTED일 때)
  approvedAt   DateTime? // 운영자 승인 일시

  settlementBank    String? // 정산 계좌 은행명
  settlementAccount String? // 암호화 저장 (평문 금지, §7.4)

  facilities         Facility[] // 클레임 승인으로 연동된 시설 목록
  claims             FacilityClaim[] // 이 파트너가 신청한 시설 클레임 이력
  leads              Lead[] // 이 파트너에게 귀속된 리드 목록
  settlements        Settlement[] // 월 정산 이력
  commissionPolicies CommissionPolicy[] // 이 파트너 전용 특약 요율 (없으면 기본 요율 적용)

  createdAt DateTime @default(now()) // 가입 신청 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([status])
}

// 시설 소유권 클레임 (§3.3) — 신청/심사 API는 이번 범위(0~3단계) 밖, 스키마만 선반영
model FacilityClaim {
  id         String   @id @default(uuid()) // 고유 식별자(UUID)
  partnerId  String // 클레임을 신청한 사업자
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  facilityId String // 클레임 대상 시설
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  evidenceUrl String? // 시설 인허가증 등 소유 증빙
  reviewNote  String? // 운영자 심사 메모
  reviewedAt  DateTime? // 운영자 심사 일시
  createdAt   DateTime  @default(now()) // 클레임 신청 일시

  @@unique([partnerId, facilityId]) // 같은 사업자의 중복 신청 방지
  @@index([status])
}

// 견적요청 번호(leadNo) 발번용 일자별 원자적 카운터.
// UPDATE ... SET seq = seq + 1 형태(Prisma upsert increment)가 Postgres 행 잠금으로
// 동시 요청에서도 안전하다 — leadNo @unique와 함께 이중 방어(§4.2).
model LeadNumberCounter {
  dateKey String @id // 'YYMMDD'
  seq     Int    @default(0) // 해당 날짜의 다음 발번 시퀀스 (Postgres 행 잠금 기반 원자적 증가)
}

// 리드 (문의 · 견적요청 · 답사예약) — 수수료 청구의 증거 (§4)
model Lead {
  id     String @id @default(uuid()) // 고유 식별자(UUID)
  leadNo String @unique // EB-260810-0001 (표시·대조용, 불변, §4.2)
  type   String // QUOTE | CONSULT | CALL (§4.1 — BOOKING은 2026-08-11 FacilityBooking 폐기와 함께 제거됨)

  facilityId String? // 리드가 발생한 시설. FUNERAL_FACILITY 파트너는 필수, ESTATE_CLEANUP은 null
  // (03-02 §4.1) — 컬럼은 열려 있지만 강제는 앱 레벨에서 한다. leadService.createLead가 그 지점이다.
  facility   Facility? @relation(fields: [facilityId], references: [id])
  partnerId  String? // 발생 시점 귀속 파트너 (없으면 비제휴)
  partner    Partner? @relation(fields: [partnerId], references: [id])

  userId String? // 로그인 유저면 참조 (탈퇴 시 null)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 신청자 스냅샷 (§4.4) — 정산 확정 후 마스킹
  applicantName  String? // 신청 시점 이름 스냅샷
  applicantPhone String? // 신청 시점 연락처 스냅샷
  maskedAt       DateTime? // 마스킹 처리 일시 (null이면 아직 원본 유지)

  payload Json // type별 요청 내용 (희망일시/하객수/종교/예산 등)

  thirdPartyConsentAt DateTime? // 개인정보 제3자 제공 동의 시각 (§7.1)
  consentSnapshot     Json? // 동의 시점의 고지 문구 버전 — 분쟁 대비

  status        String @default("REQUESTED") // REQUESTED|NOTIFIED|RESPONDED|CONVERTED|LOST|INVALID (§4.3)
  statusHistory Json   @default("[]") // [{status, at, by, note}]

  billable           Boolean           @default(false) // 청구 대상 여부 (운영자 확정)
  billedAmount       Int? // 청구 금액 스냅샷 (§8.2)
  commissionPolicyId String? // 어느 요율로 계산했는지 (분쟁 시 유일한 증거)
  commissionPolicy   CommissionPolicy? @relation(fields: [commissionPolicyId], references: [id])
  settlementId       String? // 정산에 포함된 이후 채워짐
  settlement         Settlement?       @relation(fields: [settlementId], references: [id])
  disputeReason      String? // 정산 이의제기 사유

  createdAt DateTime @default(now()) // 리드 발생 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([partnerId, status])
  @@index([facilityId, createdAt])
  @@index([createdAt])
}

// 수수료 정책 — 값이 아니라 "유효기간이 붙은 레코드"로 관리 (§8.2, §12.2)
model CommissionPolicy {
  id       String   @id @default(uuid()) // 고유 식별자(UUID)
  basis    String // PER_CONVERSION | PER_LEAD | MONTHLY_FLAT
  amount   Int? // 정액(원)
  rate     Decimal? @db.Decimal(5, 4) // 정률 (0.0500 = 5%)
  currency String   @default("KRW") // 통화 단위 (기본 원화)

  partnerId String? // null = 기본 요율 / 값 = 해당 파트너 특약
  partner   Partner? @relation(fields: [partnerId], references: [id])

  effectiveFrom DateTime // 적용 시작 시점
  effectiveTo   DateTime? // null이면 현재 유효

  memo      String? // 이 요율인 이유 (특약 사유 등)
  createdBy String? // 변경한 운영자 User.id
  createdAt DateTime @default(now()) // 정책 등록 일시

  leads Lead[] // 이 요율이 적용된 리드 목록

  @@index([partnerId, effectiveFrom])
}

// 월 정산 (§8.1) — 발행/이의제기 API는 이번 범위 밖, 스키마만 선반영
model Settlement {
  id        String    @id @default(uuid()) // 고유 식별자(UUID)
  partnerId String // 정산 대상 사업자
  partner   Partner   @relation(fields: [partnerId], references: [id])
  periodYm  String // '2026-08'
  leadCount Int // 정산 대상 리드 건수
  amount    Int // 정산 총액(원)
  status    String    @default("DRAFT") // DRAFT | ISSUED | DISPUTED | PAID
  issuedAt  DateTime? // 정산서 발행 일시
  paidAt    DateTime? // 실제 지급 완료 일시
  leads     Lead[] // 이 정산에 포함된 리드 목록
  createdAt DateTime  @default(now()) // 레코드 생성 일시

  @@unique([partnerId, periodYm]) // 같은 달 중복 발행 방지
}

// ─────────────────────────────────────────────────────────────────
// 전문가(변호사·세무사·행정사·장례지도사) 계정 체계 — Partner(장사시설)와 완전 분리.
// docs/02_전문가_매칭/02-02_전문가_계정_체계_구현_메모.md 참고.
// 의도적으로 Lead/CommissionPolicy 관계를 만들지 않는다 — 변호사법 제34조 때문에
// 직역별 수수료 구조가 갈라져 있어(같은 문서 §2), Partner의 리드 구조를 그대로
// 재사용하면 변호사만 예외 처리해야 해서 스키마가 오염된다.
// ─────────────────────────────────────────────────────────────────
model Expert {
  id               String  @id @default(uuid()) // 고유 식별자(UUID)
  email            String  @unique // 로그인 ID
  passwordHash     String // bcrypt 해시 (평문 저장 금지)
  refreshTokenHash String? // Partner와 동일한 회전 방식(sha256 해시)

  category      String // LAWYER | JUDICIAL_SCRIVENER | TAX_ACCOUNTANT | ADMINISTRATIVE_SCRIVENER | FUNERAL_DIRECTOR (docs 02-05 §3.3)
  name          String // 전문가 본인 성명
  licenseNo     String // 자격증·등록번호 (사업자등록번호 아님 — 변호사/세무사 등록번호 등)
  licenseOrg    String? // 등록 기관 (대한변호사협회, 한국세무사회 등)
  licenseDocUrl String? // 자격증 사본 (비공개 스토리지)
  contactPhone  String // 연락처 (숫자만 정규화 저장, utils/phone.ts)
  officeAddress String? // 사무실 주소 (전문직 신뢰도·안내용, 선택 입력)

  bio         String? // 소개·경력
  specialties String[] @default([]) // 세부 전문 분야

  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED — 자동승인 없음(Partner와 동일 원칙)
  rejectReason String? // 반려 사유 (status=REJECTED일 때)
  approvedAt   DateTime? // 운영자 승인 일시
  // isPublished: 승인(status=APPROVED)과 공개 노출을 분리하는 독립 플래그 — 승인은 됐지만
  // 프로필이 미비해 아직 노출하고 싶지 않은 경우가 있다(docs 02-03 §4.3). 운영자가 직접 켠다.
  isPublished  Boolean   @default(false) // 소비자 목록(GET /api/experts)에 노출할지 여부

  settlementBank    String? // 정산 계좌 은행명
  settlementAccount String? // 암호화 저장. 변호사 카테고리는 건별 정산 자체가 없음(Tier3 월정액 광고만)

  consultRequests ConsultRequest[] // 이 전문가에게 들어온 상담 신청 목록 (docs 02-03)

  createdAt DateTime @default(now()) // 가입 신청 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@unique([category, licenseNo]) // 같은 자격증 번호 중복 가입 방지
  @@index([status])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────────
// 전문가 상담 신청 (Stage 1 — 무과금 루프). docs/02_전문가_매칭/02-03_전문가_공개노출_및_상담신청_명세서.md
// Lead(장사시설)와 의도적으로 분리한다 — 대상 주체가 다르고(Expert vs Partner), 변호사법
// 제34조 때문에 과금 가능 여부가 직역별로 갈린다(§3). 그래서 이 테이블엔 과금 컬럼을 아예
// 두지 않는다 — billable/billedAmount/commissionPolicyId 같은 필드가 없으면 실수로도 못
// 채운다(§3.2, docs 02-02 §2가 Lead 재사용을 거부한 논리와 동일).
// ─────────────────────────────────────────────────────────────────
model ConsultRequest {
  id        String @id @default(uuid()) // 고유 식별자(UUID)
  requestNo String @unique // EC-YYMMDD-NNNN (표시·대조용 불변 번호, Lead의 EB-와 접두어로 구분)

  expertId         String // 신청 대상 전문가
  expert           Expert @relation(fields: [expertId], references: [id])
  categorySnapshot String // 신청 시점의 전문가 직역 — 전문가가 나중에 카테고리를 바꿔도 당시 기준 보존

  userId String? // 로그인 유저면 참조 (탈퇴 시 null)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 신청자 스냅샷 — 정산 확정 후가 아니라 일정 기간 경과 후 마스킹(§8, Lead §4.4와 동일 원칙)
  applicantName  String? // 신청 시점 이름 스냅샷
  applicantPhone String? // 신청 시점 연락처 스냅샷
  maskedAt       DateTime? // 마스킹 처리 일시 (null이면 아직 원본 유지)

  channel     String // ALIMTALK | PHONE | VIDEO | VISIT — 희망 상담 방식
  preferredAt DateTime? // 희망 상담 일시 (선택)
  content     String // 상담 희망 내용

  thirdPartyConsentAt DateTime? // 개인정보 제3자 제공 동의 시각 — 없으면 접수 거부(§5.2)
  consentSnapshot     Json? // 동의 시점의 고지 문구 버전 — 분쟁 대비

  status        String @default("REQUESTED") // REQUESTED | ACCEPTED | COMPLETED | CANCELLED | INVALID
  statusHistory Json   @default("[]") // [{status, at, by, note}]

  createdAt DateTime @default(now()) // 신청 접수 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([expertId, status])
  @@index([createdAt])
}

// 상담 신청 번호(requestNo) 발번용 일자별 원자적 카운터. LeadNumberCounter와 별도 테이블 —
// EB-(리드)와 EC-(상담)의 일련번호가 서로를 건너뛰면 대조가 어려워진다(docs 02-03 §4.2).
model ConsultNumberCounter {
  dateKey String @id // 'YYMMDD'
  seq     Int    @default(0) // 해당 날짜의 다음 발번 시퀀스 (Postgres 행 잠금 기반 원자적 증가)
}

// ─────────────────────────────────────────────────────────────────
// 디지털 계정 정리(docs 04-01) · 온라인 추모관(docs 05-01). 2026-08-12 도메인 재편으로 구 03-02가 분할됨.
// "대행"이 아니라 "안내 + 진행 추적"으로 도메인을 재정의했다(§2) — 고인 계정 자격증명·증빙서류
// 컬럼을 의도적으로 두지 않는다(§1.1-2, §3.3, §9.1-1). 위임 대행이 필요하면 Domain 02
// 행정사 상담(ConsultRequest)으로 연결하며, 이 도메인엔 별도 과금 구조를 만들지 않는다(§3.4).
// ─────────────────────────────────────────────────────────────────

// 디지털 플랫폼 안내 카탈로그(§3.1) — 운영자가 관리하는 마스터 데이터, 유저 데이터 아님.
// 금융·가상자산 플랫폼은 이 테이블에 절대 넣지 않는다(§3.2 C분류, §1.1 배제 근거).
model DigitalPlatform {
  id             String    @id @default(uuid()) // 고유 식별자(UUID)
  name           String // 표시명 (예: '네이버')
  category       String // EMAIL | SNS | CLOUD | SUBSCRIPTION | ETC
  actionType     String // DELETE(삭제) | MEMORIALIZE(추모 전환) | CANCEL(해지)
  officialUrl    String? // 공식 유족 절차 안내 페이지
  requiredDocs   String[]  @default([]) // 필요 서류 체크리스트 — 파일 자체는 받지 않는다(§3.3)
  guideSummary   String // 절차 요약 — 유족이 읽는 본문
  estimatedDays  Int? // 예상 소요일 (참고값)
  needsAgentHelp Boolean   @default(false) // true면 행정사 상담(Domain 02) 유도(§3.4)
  isPublished    Boolean   @default(false) // 확인 완료 전에는 노출 안 함
  lastVerifiedAt DateTime? // 최종 확인일 — 화면에 함께 노출(§3.1). 오래되면 운영자 화면에서 경고
  sortOrder      Int       @default(0) // 노출 순서
  createdAt      DateTime  @default(now()) // 등록 일시
  updatedAt      DateTime  @updatedAt // 최종 수정 일시

  cleanupItems DigitalCleanupItem[] // 이 플랫폼을 대상으로 한 유족들의 진행 항목

  @@index([category, isPublished])
}

// 유족 개인의 디지털 정리 진행 추적(§3). 증빙 파일 컬럼은 없다 — 없는 필드는 실수로도
// 채워질 수 없다(§3.3, §9.1-1, docs 02-03 §3.2와 동일 논리).
model DigitalCleanupItem {
  id         String           @id @default(uuid()) // 고유 식별자(UUID)
  userId     String // FK → User (03-01 §2 원칙, §5.5) — "보는 사람"
  user       User             @relation(fields: [userId], references: [id])
  deceasedId String? // FK → Deceased.id — "누구의 계정에 대한 정리인가". null이면 "내 것"(생전 본인)(04-01 §4.2-1) 🔴 User.id 아님
  deceased   Deceased?        @relation(fields: [deceasedId], references: [id])
  origin     String           @default("MANUAL") // MANUAL(직접 추가) | DISCOVERED(STEP 1 발견) | INHERITED(생전 목록 승계)(04-01 §4.2)
  platformId String? // FK → DigitalPlatform (직접 입력 항목이면 null)
  platform   DigitalPlatform? @relation(fields: [platformId], references: [id])
  customName String? // 카탈로그에 없는 서비스를 유족이 직접 추가한 경우

  status        String  @default("TODO") // TODO | PREPARING | SUBMITTED | DONE | BLOCKED
  statusHistory Json    @default("[]") // [{status, at, note}]
  memo          String? // 유족 개인 메모 (접수번호 등을 본인이 적어두는 칸)

  createdAt DateTime @default(now()) // 항목 추가 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([userId, deceasedId, status])
}

// 온라인 추모관(§4) — 고인 1명당 1개, 유족이 개설(§4.1). 공개범위 기본값은 PUBLIC이 아니라
// LINK다(§4.2) — 사망 사실+유족 구성이 공개 색인되면 부고 사칭 보이스피싱의 표적 정보가 된다.
model Memorial {
  id              String @id @default(uuid()) // 고유 식별자(UUID)
  slug            String @unique // 공개 URL용 추측 불가 토큰(§4.2, §9.1-2) — 순번 금지
  createdByUserId String // FK → User — 개설자(상주)
  createdByUser   User   @relation(fields: [createdByUserId], references: [id])

  // docs 07-03 §4.1 — E안(부고장=봉투/추모관=목적지)은 Obituary와 Memorial이 같은 고인을
  // 가리켜야 한다. 07 부고장 개설 트랜잭션(§5.2)에서 함께 생성·연결된다.
  deceasedId String
  deceased   Deceased @relation(fields: [deceasedId], references: [id])
  obituary   Obituary? // 1:1 역참조 — Obituary.memorialId가 unique라 이 방향은 선택적

  deceasedName      String // 고인 성명
  deceasedBirthDate DateTime? // 생년월일 — 공개 응답에서 제외(§4.2, §6.1)
  deceasedDeathDate DateTime? // 사망일
  portraitUrl       String? // 영정 사진
  epitaph           String? // 추모 문구

  visibility          String    @default("LINK") // PRIVATE | LINK | PUBLIC (§4.2)
  falseReportAgreedAt DateTime // 허위 개설 시 법적 책임 고지 동의 시각(§4.3-4)
  reportedAt          DateTime? // 신고 접수 시각 — 값이 있으면 자동 PRIVATE 전환(§4.3-3, §9.1-5)
  reviewedAt          DateTime? // 운영자 확인 시각
  closedAt            DateTime? // 개설자가 닫음 (소프트 삭제)

  createdAt DateTime @default(now()) // 개설 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  // 보존기간·폐쇄 정책(00-20 §8.1, §8.1-2 확정, 00-22 E-9). 상수는 config/policy.ts가 정본.
  expiresAt DateTime? // 활성 만료 시점 — 개설 시 createdAt + MEMORIAL_ACTIVE_DAYS, 연장 시 갱신
  frozenAt  DateTime? // 동결 시각. 값이 있으면 방명록·헌화·사진 "추가"만 차단(읽기·삭제는 유지, §5.1)
  purgeAt   DateTime? // 완전 파기 예정 시각 — 동결 +3년 또는 폐쇄 요청 +30일이 채운다(§5.2-1, §6.3-1)

  tributes  MemorialTribute[] // 헌화 목록
  guestbook MemorialGuestbook[] // 방명록 목록
  photos    MemorialPhoto[] // 사진 앨범

  @@index([createdByUserId])
  @@index([visibility])
}

// 헌화(§4.4) — 비회원 허용, 로그인 사용자는 1인 1회 보장. IP는 원문 저장 금지, 해시만(§9.1-6).
model MemorialTribute {
  id          String   @id @default(uuid()) // 고유 식별자(UUID)
  memorialId  String // 헌화 대상 추모관
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  userId      String? // FK → User (비회원이면 null)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorHash String // 비회원 중복 억제용 해시(브라우저 토큰+IP 조합) — IP 원문 저장 금지(§4.4)
  createdAt   DateTime @default(now()) // 헌화 일시

  @@unique([memorialId, userId]) // 로그인 사용자 1인 1회 보장 (userId=null인 비회원 행은 유니크 제약 미적용)
}

// 방명록(§4.5) — 비회원 작성 허용, 작성자명은 스냅샷(01-05 §4.4 원칙 승계, §5.5).
model MemorialGuestbook {
  id                 String    @id @default(uuid()) // 고유 식별자(UUID)
  memorialId         String // 방명록 대상 추모관
  memorial           Memorial  @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  userId             String? // FK → User (비회원이면 null)
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName         String // 작성자명 스냅샷
  relationToDeceased String? // 고인과의 관계 (예: '친구')
  message            String // 본문
  deletedByOwnerAt   DateTime? // 상주가 삭제(§4.5) — 소프트 삭제
  hiddenAt           DateTime? // 운영자 강제 비공개 — 소프트 삭제로 원문 보존
  createdAt          DateTime  @default(now()) // 작성 일시

  @@index([memorialId, createdAt])
}

// 추모 사진(§4.6) — 업로드는 구현하되 실서비스 오픈은 오브젝트 스토리지 전환 이후로 묶는다
// (systems.md §5, §9.1-7). 업로드 상한 등 수치는 policy.ts에 둔다(01-05 §12).
model MemorialPhoto {
  id               String   @id @default(uuid()) // 고유 식별자(UUID)
  memorialId       String // 사진이 속한 추모관
  memorial         Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  uploadedByUserId String // FK → User — 업로드 권한은 개설자로 제한(초기)
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  url              String // 이미지 URL
  title            String // 사진 제목
  sortOrder        Int      @default(0) // 대표 사진은 sortOrder 최소값 (Facility.images[0] 규칙과 동일 사상)
  createdAt        DateTime @default(now()) // 등록 일시

  @@index([memorialId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────
// 모바일 부고장(Domain 07) — docs/07_상중_행정_케어/07-03_모바일_부고장_카카오톡_전송_구현_기획서.md
// Phase 1. E안(00-13 §4.5) — 부고장(Obituary)=봉투, 추모관(Memorial)=목적지, 배포 링크는 1개.
// ─────────────────────────────────────────────────────────────────

// 고인(00-12 §2.1). 07 착수의 전제이므로 여기서 최소 범위로 도입한다.
// ⚠️ DeathVerification·BereavedRelation·PreDeathDirective는 이번 범위 밖 —
//    00-12가 확정될 때 이 모델에 붙는다(관계 필드만 미리 열어두지 않는다).
model Deceased {
  id           String    @id @default(uuid())
  userId       String?   @unique // 이어봄 회원이었으면 연결. 비회원 고인이면 null(케이스 B)
  name         String
  birthDate    DateTime?           // ⚠️ 공개 응답에서 제외(05-01 §4.1과 동일 사상)
  deathDate    DateTime?
  registeredBy String              // 등록한 User — 자칭 유족일 수 있음(00-12 §2.3)
  createdAt    DateTime  @default(now())

  obituaries   Obituary[]
  memorials    Memorial[]
  cleanupItems DigitalCleanupItem[] // docs 04-01 §4.2-1 — 이 고인 명의의 디지털 정리 진행 항목
}

// 부고장 — Domain 07 소유. 단명(장례 전후), 배포되는 유일한 링크(00-13 §4.5)
model Obituary {
  id              String   @id @default(uuid())
  slug            String   @unique   // 배포용 추측 불가 토큰(§4.4)
  deceasedId      String
  deceased        Deceased @relation(fields: [deceasedId], references: [id])
  memorialId      String   @unique   // 개설 시 함께 생성된 추모관(00-13 §4.5 · 권고 #3)
  memorial        Memorial @relation(fields: [memorialId], references: [id])
  createdByUserId String              // 개설자(상주)
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])

  // 장례 실무 정보 — 05가 아니라 여기 있다(00-13 §4.5-2)
  funeralHall     String?             // 빈소(장례식장명)
  mourningRoom    String?             // 호실
  funeralHallAddr String?             // 빈소 주소 — 지도/길찾기용
  facilityId      String?             // FK → Facility. 목록에서 고른 경우만(01 연결)
  coffinAt        DateTime?           // 입관 — 화면에서는 접어둠(§6.2)
  funeralAt       DateTime            // 발인 — ✅ 2026-08-20 필수 확정(§6.2-1). 수명 계산 기준(§6.2-4)
  burialSite      String?             // 장지 — 화면에서는 접어둠(§6.2)

  // 연락처 — ✅ 2026-08-20 개발자 지정. 입력하면 랜딩에 노출(별도 토글 없음, §6.2-2)
  // ⚠️ 암호화하지 않는다: 입력=공개가 전제라 DB값과 공개값이 항상 같다. 계좌(기본 OFF라
  //    꺼진 값이 DB에 쌓임)와 달리 암호화가 막아주는 위협이 없다 — 보안 연극을 만들지 않는다.
  contactPhone    String?

  // 조의금 계좌 — ✅ 2026-08-20 개발자 확정: 기능 도입. 기본 OFF + 유족 토글(§8 #3)
  accountEnabled  Boolean  @default(false)
  accountBankCode String?
  accountNumberEnc String?            // AES-256-GCM. utils/crypto.ts encryptField 재사용
  accountHolder   String?

  // 카톡 카드에 영정 사용 — ✅ 2026-08-20 확정(§3.3-1). Phase 1~2에는 화면에 노출하지 않는다.
  // ⚠️ 이미지 스토리지 전환(00-11) 전까지 true로 켤 수 없다 — 켜면 재배포 시 카드가 깨진다.
  portraitShareEnabled Boolean @default(false)

  // 게이트 — 05-01 §2.3을 07이 승계(00-13 §4.5-3)
  falseReportAgreedAt DateTime         // 허위 개설 고지 동의 시각
  resharedNoticeAckAt DateTime         // 재전파 고지 확인 시각(00-13 §8-6)

  shareCount      Int      @default(0) // 집계값만. 수신자 식별 정보는 저장하지 않음
  viewCount       Int      @default(0)

  // 카드 반영 필드(고인 성함·빈소·호실·발인)가 마지막으로 바뀐 시각(§5.4-2).
  // ⚠️ updatedAt으로 대체할 수 없다 — 연락처만 고쳐도 updatedAt은 바뀌므로
  //    "다시 공유하세요" 안내가 잘못 뜬다. 카드 반영 필드에서만 갱신한다.
  cardFieldsUpdatedAt DateTime?
  closedAt        DateTime?           // 수동 종료 시각(§9 #9). null이어도 발인+3일 지나면 조회 시점에 자동 종료로 취급(§6.2-4) — 별도 컬럼 없음
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mourners        ObituaryMourner[]

  @@index([createdByUserId])
}

// 상주·유족 — 부고는 관계별로 여러 명을 나란히 적는 것이 관행이다(§4.3)
model ObituaryMourner {
  id           String   @id @default(uuid())
  obituaryId   String
  obituary     Obituary @relation(fields: [obituaryId], references: [id], onDelete: Cascade)
  relationship String            // 배우자 | 장남 | 차녀 | 사위 | 며느리 ...
  name         String
  isChief      Boolean  @default(false)  // 상주 표시
  sortOrder    Int      @default(0)

  @@index([obituaryId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────
// 엔딩노트 + 유족 메시지 보관함(Domain 06) — docs/06_엔딩노트_유언/06-04(본체)·06-05(보관함 분리)
// 06-04 §10 Phase 1(2026-08-27)에서 EndingNoteEntry가 추가됐다 — ①②④⑤⑥⑦⑧⑨⑩ 9개 섹션 본문이
// 이제 실제로 저장된다. EndingNoteGrant·EndingNoteLog는 여전히 Phase 2·3 몫이라 만들지 않는다(§10).
// ─────────────────────────────────────────────────────────────────

// 엔딩노트 1건 — User 1:1. 개봉 상태(status)의 유일한 소유자다(06-05 §3.2·§3.3) — FarewellMessage는
// 자기 상태 필드를 갖지 않고, 이 모델의 status가 RELEASED가 되는 순간 양쪽이 함께 열린다.
model EndingNote {
  id     String @id @default(uuid()) // 고유 식별자(UUID)
  userId String @unique // 이 엔딩노트의 본인(User 1:1)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         String    @default("DRAFT") // DRAFT|SEALED|RELEASED|FROZEN — §3.3, 클라이언트가 정하지 않는다
  sealedAt       DateTime?
  releasedAt     DateTime?
  policyAgreedAt DateTime? // 06-03 §5 열람 정책 동의 시각 — 가입 시점이 아니라 작성 시작 시점에 스탬프
  lastConfirmedAt DateTime?
  sectionState   Json?     // 06-04 §4.2·§6.2 — 섹션별 "작성 완료 여부"만(예: {"ASSET":true}). 내용은 절대 넣지 않는다. 서버가 갱신(클라이언트 값 불신)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farewellMessages FarewellMessage[]
  entries          EndingNoteEntry[] // 06-04 §4.2 — 본문·암호문. 운영자 쿼리에 절대 포함하지 않는다(06-03 §3.1 A안)
  grants           EndingNoteGrant[] // 06-04 §4.2·§10 Phase 2 — 누구에게 어떤 섹션을 언제 여는가

  @@index([userId, status])
}

// 유족 메시지 — 수신자별 1:1이 본체(06-05 §6.2, §2). releaseTiming·status 컬럼을 의도적으로 두지
// 않는다 — 사후 고정(§3.3)이고 상태 소유자는 EndingNote 하나뿐이다.
model FarewellMessage {
  id     String     @id @default(uuid()) // 고유 식별자(UUID)
  noteId String // FK → EndingNote — 이 편지가 속한 엔딩노트(본인)
  note   EndingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  recipientId String            // FK → FamilyDesignation. 🔴 NOT NULL — "전원에게"는 여기 두지 않는다(§6.2)
  recipient   FamilyDesignation @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  title   String? // 평문 허용 — 목록 미리보기 표시용(§6.2)
  bodyEnc String  // 🔴 AES-256-GCM 암호문(utils/crypto.ts encryptNoteField, ENDING_NOTE_ENCRYPTION_KEY). 평문 컬럼 없음(§6.2)

  mediaKey         String? // Phase D(음성). R2 오브젝트 키. 🔴 삭제해도 null로 만들지 않는다(§5.6-4)
  mediaMime        String? // Phase D
  mediaDurationSec Int?    // Phase D
  mediaDeletedAt   DateTime? // 🆕 Phase D-6(§5.6-4). 음성만 소프트 삭제한 시각. null이면 정상 첨부.
  // 🔴 유예 30일 뒤 사람 승인 배치가 원본+아카이브를 지우고 그때 mediaKey를 정리한다 — 런타임
  // 요청 경로에서 DeleteObject를 호출하지 않는다.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([recipientId])
}

// 엔딩노트 본문 — 06-04 §4.2 Phase 1. 섹션별 1건(upsert), 운영자 쿼리에 절대 조인하지 않는다
// (06-03 §3.1 A안 — 운영자 화면은 EndingNote까지만). §7.4 격리를 3층(API·쿼리·UI)에서 지킨다.
model EndingNoteEntry {
  id     String     @id @default(uuid()) // 고유 식별자(UUID)
  noteId String // FK → EndingNote — 이 섹션이 속한 엔딩노트(본인)
  note   EndingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  section String // §6.1 코드(③ 제외) — LIFE_SUPPORT|FUNERAL|ASSET|DIGITAL_ACCOUNTS|INSURANCE|CONTACTS|WILL_LOCATION|WILL_DRAFT|ORGAN_DONATION
  title   String? // 평문 허용 — 목록 표시용(§13 #3). 사용자가 붙이는 선택적 제목이며 섹션명(시스템 표시)과 별개
  bodyEnc String  // 🔴 AES-256-GCM 암호문(utils/crypto.ts encryptNoteField, ENDING_NOTE_ENCRYPTION_KEY). 평문 컬럼 없음

  releaseTiming String? // IMMEDIATE|EMERGENCY|POSTMORTEM(§7.1). 🔴 WILL_DRAFT(⑨)는 항상 null — 어떤
  // 시점도 부여받지 못한다(§7.4 모델 레벨 차단, 컨트롤러에서 강제). Phase 1은 시점 선택 UI가 없어
  // 서버가 섹션별 고정값을 붙인다 — EMERGENCY는 Phase 3(응급 열람 확정) 전까지 어디에도 쓰지 않는다(§13 #1)

  recipientId String? // FK → FamilyDesignation. null이면 지정 유족 전원 — 수신자별 분기는 Phase 2(§7.1 시점 UI)부터 실제로 쓰인다
  recipient FamilyDesignation? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt // 본인 최종 수정 일시
  createdAt DateTime @default(now()) // 최초 저장 일시

  @@unique([noteId, section]) // 섹션당 본문 1건 — upsert 대상
  @@index([noteId])
}

// 열람 시점 부여 — 06-04 §4.2·§7·§10 Phase 2. "누구에게(designation) · 어떤 섹션을 · 언제(timing)
// 여는가"의 단위. EndingNoteEntry.releaseTiming(섹션의 기본 정책값)과는 별개로, 가족마다 다른
// 시점을 줄 수 있다 — 예: 배우자는 장례 희망을 생전에, 다른 가족은 사후에만.
model EndingNoteGrant {
  id     String     @id @default(uuid()) // 고유 식별자(UUID)
  noteId String // FK → EndingNote — 이 권한이 속한 엔딩노트(본인)
  note   EndingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  designationId String // FK → FamilyDesignation — 누구에게
  designation   FamilyDesignation @relation(fields: [designationId], references: [id], onDelete: Cascade)

  section String // §6.1 코드 또는 ALL(모델 정의상 허용). 🔴 WILL_DRAFT(⑨)는 컨트롤러가 항상 거부한다(§7.4 모델 레벨 차단)
  timing  String // IMMEDIATE|POSTMORTEM. 🔴 EMERGENCY는 Phase 3(응급 열람 확정) 전까지 발급하지 않는다(§13 #1)

  revokedAt DateTime? // 🔴 철회 시각 — null이면 유효(§4.2 "한 번 준 권한을 되돌릴 수 없으면 안 된다")

  createdAt DateTime @default(now()) // 최초 부여 일시
  updatedAt DateTime @updatedAt // 최종 변경(재부여·철회) 일시

  @@unique([noteId, designationId, section]) // 가족·섹션 조합당 권한 1건 — timing은 덮어써서 바꾼다
  @@index([noteId])
  @@index([designationId])
}

// ─────────────────────────────────────────────────────────────────
// 운영자(내부 직원) 계정 — Partner/Expert와 인증 패턴은 같지만 **공개 가입 API가 없다.**
// 계정 생성은 시드 스크립트(prisma/seed-admin.ts)로만 한다 — 가입 폼을 공개하면
// 그 자체가 보안 구멍이 된다. 2026-08-10 신설 — 장사시설/전문가 가입 승인 + 시설 클레임 승인용.
// ─────────────────────────────────────────────────────────────────
model Admin {
  id               String  @id @default(uuid()) // 고유 식별자(UUID)
  email            String  @unique // 로그인 ID
  passwordHash     String // bcrypt 해시 (평문 저장 금지)
  refreshTokenHash String? // 발급된 refresh token의 sha256 해시 (회전·재사용 탐지용)
  name             String // 운영자 이름

  createdAt DateTime @default(now()) // 계정 생성 일시 (seed-admin.ts로만 생성됨)
  updatedAt DateTime @updatedAt // 최종 수정 일시
}
