datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 유저 마스터 (B2C 일반 회원) — Partner/Expert/Admin과는 완전히 분리된 별도 인증 체계
model User {
  id                  String               @id @default(uuid()) // 고유 식별자(UUID)
  email               String?              @unique // 유저 대표 이메일 (유니크)
  name                String // 유저 이름 / 닉네임
  profileImage        String? // 대표 프로필 이미지 URL
  role                String               @default("USER") // 'USER', 'EXPERT', 'ADMIN'
  refreshToken        String? // JWT Refresh Token
  accounts            SocialAccount[] // 연동된 소셜 계정 목록
  facilityReviews     FacilityReview[] // 이 유저가 작성한 시설 리뷰 목록
  leads               Lead[] // docs/01_.../01-05 — 이 유저가 남긴 문의/견적요청 리드
  consultRequests     ConsultRequest[] // docs/02_.../02-03 — 이 유저가 남긴 전문가 상담 신청
  digitalCleanupItems DigitalCleanupItem[] // docs/03_.../03-02 — 디지털 정리 진행 항목
  memorials           Memorial[] // docs/03_.../03-02 — 개설한 추모관
  memorialTributes    MemorialTribute[] // 남긴 헌화
  memorialGuestbooks  MemorialGuestbook[] // 남긴 방명록
  memorialPhotos      MemorialPhoto[] // 업로드한 추모 사진
  createdAt           DateTime             @default(now()) // 가입 일시
  updatedAt           DateTime             @updatedAt // 최종 수정 일시
}

// 소셜 로그인 계정 (User 1:N) — 카카오/네이버/구글 연동 정보, 1인 다계정 연동 지원
model SocialAccount {
  id         String    @id @default(uuid()) // 고유 식별자(UUID)
  userId     String // 이 소셜 계정이 연동된 User
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // 'KAKAO', 'NAVER', 'GOOGLE'
  providerId String // 각 소셜 제공자의 고유 식별자 ID
  email      String? // 소셜 프로필상의 이메일
  createdAt  DateTime  @default(now()) // 최초 연동 일시
  unlinkedAt DateTime? // null이면 연동 중. 값이 있으면 사용자가 연동 해제한 상태(소프트 삭제) —
  // 재로그인 시 이 provider+providerId를 다시 인식해 같은 계정으로 복구하기 위해 하드 삭제하지 않음

  @@unique([provider, providerId])
}

// 시설 마스터 (장례식장 / 묘지·수목장)
model Facility {
  id           String   @id // 고유 식별자 — 소스별 규칙 있음(CSV: bongan_NNN/jayeon_NNN, 카카오: kakao_<placeId>, 수기 시드: f_*)
  name         String // 시설명
  type         String // '장례식장' | '묘지/수목장'
  location     String // 도로명 주소 (화면 표시용 — 전남광주통합특별시 등 병합 표기는 utils/address.ts 정규화 거침)
  lat          Float // 위도
  lng          Float // 경도
  phone        String? // 실데이터 수집(카카오/공공 CSV) 시 채워지는 연락처
  kakaoPlaceId String?  @unique // 카카오 로컬 API로 수집한 장례식장의 장소ID (재동기화 dedup용)
  price        String // 대표 가격 표시 문자열 (예: "950만원~")
  rating       Float    @default(0.0) // 초기 시딩값(공시 만족도 기준) — 리뷰 5건 미만일 때 노출값으로 사용
  religion     String // 수용 가능 종교 (예: '전체 종교')
  guests       String // 수용 가능 하객 규모 (예: '100~300명')
  // 파생 캐시 컬럼 — 정본은 partnerId. 클레임 승인/해지 트랜잭션 안에서만 갱신한다(docs 01-05 §3.4).
  isPartner    Boolean  @default(false) // 제휴(클레임 승인된) 시설 여부
  partnerId    String? // 클레임 승인된 사업자 (없으면 비제휴)
  partner      Partner? @relation(fields: [partnerId], references: [id])
  tags         String[] @default([]) // 표시용 태그 배열 — 분류 가능한 값(공설/사설 등)만 frontend TAG_CATALOG로 필터링됨(docs 01-06)
  amenities    String[] @default([]) // 부대시설 목록 (예: 식당/매점/주차장/유족대기실/장애인편의시설)
  images       String[] @default([]) // 파트너가 BizDashboard에서 업로드한 시설 사진 URL 목록 (2026-08-10)
  createdAt    DateTime @default(now()) // 레코드 생성 일시
  updatedAt    DateTime @updatedAt // 최종 수정 일시

  reviews FacilityReview[] // 이 시설에 달린 리뷰 목록
  claims  FacilityClaim[] // 이 시설에 대한 소유권 클레임 이력
  leads   Lead[] // 이 시설로 들어온 리드(문의/견적요청/답사예약) 목록

  @@index([partnerId])
}

// 시설 리뷰
model FacilityReview {
  id         String   @id @default(uuid()) // 고유 식별자(UUID)
  facilityId String // 리뷰 대상 시설
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId     String // 리뷰 작성자
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Float // 별점 (1~5)
  content    String // 리뷰 본문
  createdAt  DateTime @default(now()) // 작성 일시

  @@unique([facilityId, userId]) // 1인 1리뷰 (실제 답사완료 인증 체계 없어 로그인 유저 단위로 단순화)
}

// ─────────────────────────────────────────────────────────────────
// 장사시설 사업자 회원 + 리드 수수료 정산 인프라
// docs/01_장사시설_매칭/01-05_장사시설_사업자회원_및_리드_수수료_정산_명세서.md
// 2026-08-10 대표 지시 기반. §는 위 문서의 섹션 번호를 가리킨다.
// ─────────────────────────────────────────────────────────────────

// 사업자 (법인격 단위) — B2C User와 완전 분리 (§3.1)
model Partner {
  id               String  @id @default(uuid()) // 고유 식별자(UUID)
  email            String  @unique // 로그인 ID
  passwordHash     String // bcrypt 해시 (평문 저장 금지)
  refreshTokenHash String? // 발급된 refresh token의 sha256 해시 (회전·재사용 탐지용, §6.1)

  bizRegNo      String  @unique // 사업자등록번호 (하이픈 제거 10자리)
  companyName   String // 상호
  ownerName     String // 대표자명
  contactName   String // 담당자명
  contactPhone  String // 담당자 연락처 (숫자만 정규화 저장, utils/phone.ts)
  bizLicenseUrl String? // 사업자등록증 사본 (비공개 스토리지, §7.4)

  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED (§3.2)
  rejectReason String? // 반려 사유 (status=REJECTED일 때)
  approvedAt   DateTime? // 운영자 승인 일시

  settlementBank    String? // 정산 계좌 은행명
  settlementAccount String? // 암호화 저장 (평문 금지, §7.4)

  facilities         Facility[] // 클레임 승인으로 연동된 시설 목록
  claims             FacilityClaim[] // 이 파트너가 신청한 시설 클레임 이력
  leads              Lead[] // 이 파트너에게 귀속된 리드 목록
  settlements        Settlement[] // 월 정산 이력
  commissionPolicies CommissionPolicy[] // 이 파트너 전용 특약 요율 (없으면 기본 요율 적용)

  createdAt DateTime @default(now()) // 가입 신청 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([status])
}

// 시설 소유권 클레임 (§3.3) — 신청/심사 API는 이번 범위(0~3단계) 밖, 스키마만 선반영
model FacilityClaim {
  id         String   @id @default(uuid()) // 고유 식별자(UUID)
  partnerId  String // 클레임을 신청한 사업자
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  facilityId String // 클레임 대상 시설
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  evidenceUrl String? // 시설 인허가증 등 소유 증빙
  reviewNote  String? // 운영자 심사 메모
  reviewedAt  DateTime? // 운영자 심사 일시
  createdAt   DateTime  @default(now()) // 클레임 신청 일시

  @@unique([partnerId, facilityId]) // 같은 사업자의 중복 신청 방지
  @@index([status])
}

// 견적요청 번호(leadNo) 발번용 일자별 원자적 카운터.
// UPDATE ... SET seq = seq + 1 형태(Prisma upsert increment)가 Postgres 행 잠금으로
// 동시 요청에서도 안전하다 — leadNo @unique와 함께 이중 방어(§4.2).
model LeadNumberCounter {
  dateKey String @id // 'YYMMDD'
  seq     Int    @default(0) // 해당 날짜의 다음 발번 시퀀스 (Postgres 행 잠금 기반 원자적 증가)
}

// 리드 (문의 · 견적요청 · 답사예약) — 수수료 청구의 증거 (§4)
model Lead {
  id     String @id @default(uuid()) // 고유 식별자(UUID)
  leadNo String @unique // EB-260810-0001 (표시·대조용, 불변, §4.2)
  type   String // QUOTE | CONSULT | CALL (§4.1 — BOOKING은 2026-08-11 FacilityBooking 폐기와 함께 제거됨)

  facilityId String // 리드가 발생한 시설
  facility   Facility @relation(fields: [facilityId], references: [id])
  partnerId  String? // 발생 시점 귀속 파트너 (없으면 비제휴)
  partner    Partner? @relation(fields: [partnerId], references: [id])

  userId String? // 로그인 유저면 참조 (탈퇴 시 null)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 신청자 스냅샷 (§4.4) — 정산 확정 후 마스킹
  applicantName  String? // 신청 시점 이름 스냅샷
  applicantPhone String? // 신청 시점 연락처 스냅샷
  maskedAt       DateTime? // 마스킹 처리 일시 (null이면 아직 원본 유지)

  payload Json // type별 요청 내용 (희망일시/하객수/종교/예산 등)

  thirdPartyConsentAt DateTime? // 개인정보 제3자 제공 동의 시각 (§7.1)
  consentSnapshot     Json? // 동의 시점의 고지 문구 버전 — 분쟁 대비

  status        String @default("REQUESTED") // REQUESTED|NOTIFIED|RESPONDED|CONVERTED|LOST|INVALID (§4.3)
  statusHistory Json   @default("[]") // [{status, at, by, note}]

  billable           Boolean           @default(false) // 청구 대상 여부 (운영자 확정)
  billedAmount       Int? // 청구 금액 스냅샷 (§8.2)
  commissionPolicyId String? // 어느 요율로 계산했는지 (분쟁 시 유일한 증거)
  commissionPolicy   CommissionPolicy? @relation(fields: [commissionPolicyId], references: [id])
  settlementId       String? // 정산에 포함된 이후 채워짐
  settlement         Settlement?       @relation(fields: [settlementId], references: [id])
  disputeReason      String? // 정산 이의제기 사유

  createdAt DateTime @default(now()) // 리드 발생 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([partnerId, status])
  @@index([facilityId, createdAt])
  @@index([createdAt])
}

// 수수료 정책 — 값이 아니라 "유효기간이 붙은 레코드"로 관리 (§8.2, §12.2)
model CommissionPolicy {
  id       String   @id @default(uuid()) // 고유 식별자(UUID)
  basis    String // PER_CONVERSION | PER_LEAD | MONTHLY_FLAT
  amount   Int? // 정액(원)
  rate     Decimal? @db.Decimal(5, 4) // 정률 (0.0500 = 5%)
  currency String   @default("KRW") // 통화 단위 (기본 원화)

  partnerId String? // null = 기본 요율 / 값 = 해당 파트너 특약
  partner   Partner? @relation(fields: [partnerId], references: [id])

  effectiveFrom DateTime // 적용 시작 시점
  effectiveTo   DateTime? // null이면 현재 유효

  memo      String? // 이 요율인 이유 (특약 사유 등)
  createdBy String? // 변경한 운영자 User.id
  createdAt DateTime @default(now()) // 정책 등록 일시

  leads Lead[] // 이 요율이 적용된 리드 목록

  @@index([partnerId, effectiveFrom])
}

// 월 정산 (§8.1) — 발행/이의제기 API는 이번 범위 밖, 스키마만 선반영
model Settlement {
  id        String    @id @default(uuid()) // 고유 식별자(UUID)
  partnerId String // 정산 대상 사업자
  partner   Partner   @relation(fields: [partnerId], references: [id])
  periodYm  String // '2026-08'
  leadCount Int // 정산 대상 리드 건수
  amount    Int // 정산 총액(원)
  status    String    @default("DRAFT") // DRAFT | ISSUED | DISPUTED | PAID
  issuedAt  DateTime? // 정산서 발행 일시
  paidAt    DateTime? // 실제 지급 완료 일시
  leads     Lead[] // 이 정산에 포함된 리드 목록
  createdAt DateTime  @default(now()) // 레코드 생성 일시

  @@unique([partnerId, periodYm]) // 같은 달 중복 발행 방지
}

// ─────────────────────────────────────────────────────────────────
// 전문가(변호사·세무사·행정사·장례지도사) 계정 체계 — Partner(장사시설)와 완전 분리.
// docs/02_전문가_매칭/02-02_전문가_계정_체계_구현_메모.md 참고.
// 의도적으로 Lead/CommissionPolicy 관계를 만들지 않는다 — 변호사법 제34조 때문에
// 직역별 수수료 구조가 갈라져 있어(같은 문서 §2), Partner의 리드 구조를 그대로
// 재사용하면 변호사만 예외 처리해야 해서 스키마가 오염된다.
// ─────────────────────────────────────────────────────────────────
model Expert {
  id               String  @id @default(uuid()) // 고유 식별자(UUID)
  email            String  @unique // 로그인 ID
  passwordHash     String // bcrypt 해시 (평문 저장 금지)
  refreshTokenHash String? // Partner와 동일한 회전 방식(sha256 해시)

  category      String // LAWYER | TAX_ACCOUNTANT | ADMINISTRATIVE_SCRIVENER | FUNERAL_DIRECTOR (docs 02-01 §2)
  name          String // 전문가 본인 성명
  licenseNo     String // 자격증·등록번호 (사업자등록번호 아님 — 변호사/세무사 등록번호 등)
  licenseOrg    String? // 등록 기관 (대한변호사협회, 한국세무사회 등)
  licenseDocUrl String? // 자격증 사본 (비공개 스토리지)
  contactPhone  String // 연락처 (숫자만 정규화 저장, utils/phone.ts)
  officeAddress String? // 사무실 주소 (전문직 신뢰도·안내용, 선택 입력)

  bio         String? // 소개·경력
  specialties String[] @default([]) // 세부 전문 분야

  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED — 자동승인 없음(Partner와 동일 원칙)
  rejectReason String? // 반려 사유 (status=REJECTED일 때)
  approvedAt   DateTime? // 운영자 승인 일시
  // isPublished: 승인(status=APPROVED)과 공개 노출을 분리하는 독립 플래그 — 승인은 됐지만
  // 프로필이 미비해 아직 노출하고 싶지 않은 경우가 있다(docs 02-03 §4.3). 운영자가 직접 켠다.
  isPublished  Boolean   @default(false) // 소비자 목록(GET /api/experts)에 노출할지 여부

  settlementBank    String? // 정산 계좌 은행명
  settlementAccount String? // 암호화 저장. 변호사 카테고리는 건별 정산 자체가 없음(Tier3 월정액 광고만)

  consultRequests ConsultRequest[] // 이 전문가에게 들어온 상담 신청 목록 (docs 02-03)

  createdAt DateTime @default(now()) // 가입 신청 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@unique([category, licenseNo]) // 같은 자격증 번호 중복 가입 방지
  @@index([status])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────────
// 전문가 상담 신청 (Stage 1 — 무과금 루프). docs/02_전문가_매칭/02-03_전문가_공개노출_및_상담신청_명세서.md
// Lead(장사시설)와 의도적으로 분리한다 — 대상 주체가 다르고(Expert vs Partner), 변호사법
// 제34조 때문에 과금 가능 여부가 직역별로 갈린다(§3). 그래서 이 테이블엔 과금 컬럼을 아예
// 두지 않는다 — billable/billedAmount/commissionPolicyId 같은 필드가 없으면 실수로도 못
// 채운다(§3.2, docs 02-02 §2가 Lead 재사용을 거부한 논리와 동일).
// ─────────────────────────────────────────────────────────────────
model ConsultRequest {
  id        String @id @default(uuid()) // 고유 식별자(UUID)
  requestNo String @unique // EC-YYMMDD-NNNN (표시·대조용 불변 번호, Lead의 EB-와 접두어로 구분)

  expertId         String // 신청 대상 전문가
  expert           Expert @relation(fields: [expertId], references: [id])
  categorySnapshot String // 신청 시점의 전문가 직역 — 전문가가 나중에 카테고리를 바꿔도 당시 기준 보존

  userId String? // 로그인 유저면 참조 (탈퇴 시 null)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 신청자 스냅샷 — 정산 확정 후가 아니라 일정 기간 경과 후 마스킹(§8, Lead §4.4와 동일 원칙)
  applicantName  String? // 신청 시점 이름 스냅샷
  applicantPhone String? // 신청 시점 연락처 스냅샷
  maskedAt       DateTime? // 마스킹 처리 일시 (null이면 아직 원본 유지)

  channel     String // ALIMTALK | PHONE | VIDEO | VISIT — 희망 상담 방식
  preferredAt DateTime? // 희망 상담 일시 (선택)
  content     String // 상담 희망 내용

  thirdPartyConsentAt DateTime? // 개인정보 제3자 제공 동의 시각 — 없으면 접수 거부(§5.2)
  consentSnapshot     Json? // 동의 시점의 고지 문구 버전 — 분쟁 대비

  status        String @default("REQUESTED") // REQUESTED | ACCEPTED | COMPLETED | CANCELLED | INVALID
  statusHistory Json   @default("[]") // [{status, at, by, note}]

  createdAt DateTime @default(now()) // 신청 접수 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([expertId, status])
  @@index([createdAt])
}

// 상담 신청 번호(requestNo) 발번용 일자별 원자적 카운터. LeadNumberCounter와 별도 테이블 —
// EB-(리드)와 EC-(상담)의 일련번호가 서로를 건너뛰면 대조가 어려워진다(docs 02-03 §4.2).
model ConsultNumberCounter {
  dateKey String @id // 'YYMMDD'
  seq     Int    @default(0) // 해당 날짜의 다음 발번 시퀀스 (Postgres 행 잠금 기반 원자적 증가)
}

// ─────────────────────────────────────────────────────────────────
// 디지털 유품 정리 · 온라인 추모관. docs/03_디지털_유품_추모관/03-02_...명세서.md
// "대행"이 아니라 "안내 + 진행 추적"으로 도메인을 재정의했다(§2) — 고인 계정 자격증명·증빙서류
// 컬럼을 의도적으로 두지 않는다(§1.1-2, §3.3, §9.1-1). 위임 대행이 필요하면 Domain 02
// 행정사 상담(ConsultRequest)으로 연결하며, 이 도메인엔 별도 과금 구조를 만들지 않는다(§3.4).
// ─────────────────────────────────────────────────────────────────

// 디지털 플랫폼 안내 카탈로그(§3.1) — 운영자가 관리하는 마스터 데이터, 유저 데이터 아님.
// 금융·가상자산 플랫폼은 이 테이블에 절대 넣지 않는다(§3.2 C분류, §1.1 배제 근거).
model DigitalPlatform {
  id             String    @id @default(uuid()) // 고유 식별자(UUID)
  name           String // 표시명 (예: '네이버')
  category       String // EMAIL | SNS | CLOUD | SUBSCRIPTION | ETC
  actionType     String // DELETE(삭제) | MEMORIALIZE(추모 전환) | CANCEL(해지)
  officialUrl    String? // 공식 유족 절차 안내 페이지
  requiredDocs   String[]  @default([]) // 필요 서류 체크리스트 — 파일 자체는 받지 않는다(§3.3)
  guideSummary   String // 절차 요약 — 유족이 읽는 본문
  estimatedDays  Int? // 예상 소요일 (참고값)
  needsAgentHelp Boolean   @default(false) // true면 행정사 상담(Domain 02) 유도(§3.4)
  isPublished    Boolean   @default(false) // 확인 완료 전에는 노출 안 함
  lastVerifiedAt DateTime? // 최종 확인일 — 화면에 함께 노출(§3.1). 오래되면 운영자 화면에서 경고
  sortOrder      Int       @default(0) // 노출 순서
  createdAt      DateTime  @default(now()) // 등록 일시
  updatedAt      DateTime  @updatedAt // 최종 수정 일시

  cleanupItems DigitalCleanupItem[] // 이 플랫폼을 대상으로 한 유족들의 진행 항목

  @@index([category, isPublished])
}

// 유족 개인의 디지털 정리 진행 추적(§3). 증빙 파일 컬럼은 없다 — 없는 필드는 실수로도
// 채워질 수 없다(§3.3, §9.1-1, docs 02-03 §3.2와 동일 논리).
model DigitalCleanupItem {
  id         String           @id @default(uuid()) // 고유 식별자(UUID)
  userId     String // FK → User (03-01 §2 원칙, §5.5)
  user       User             @relation(fields: [userId], references: [id])
  platformId String? // FK → DigitalPlatform (직접 입력 항목이면 null)
  platform   DigitalPlatform? @relation(fields: [platformId], references: [id])
  customName String? // 카탈로그에 없는 서비스를 유족이 직접 추가한 경우

  status        String  @default("TODO") // TODO | PREPARING | SUBMITTED | DONE | BLOCKED
  statusHistory Json    @default("[]") // [{status, at, note}]
  memo          String? // 유족 개인 메모 (접수번호 등을 본인이 적어두는 칸)

  createdAt DateTime @default(now()) // 항목 추가 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  @@index([userId, status])
}

// 온라인 추모관(§4) — 고인 1명당 1개, 유족이 개설(§4.1). 공개범위 기본값은 PUBLIC이 아니라
// LINK다(§4.2) — 사망 사실+유족 구성이 공개 색인되면 부고 사칭 보이스피싱의 표적 정보가 된다.
model Memorial {
  id              String @id @default(uuid()) // 고유 식별자(UUID)
  slug            String @unique // 공개 URL용 추측 불가 토큰(§4.2, §9.1-2) — 순번 금지
  createdByUserId String // FK → User — 개설자(상주)
  createdByUser   User   @relation(fields: [createdByUserId], references: [id])

  deceasedName      String // 고인 성명
  deceasedBirthDate DateTime? // 생년월일 — 공개 응답에서 제외(§4.2, §6.1)
  deceasedDeathDate DateTime? // 사망일
  portraitUrl       String? // 영정 사진
  epitaph           String? // 추모 문구

  visibility          String    @default("LINK") // PRIVATE | LINK | PUBLIC (§4.2)
  falseReportAgreedAt DateTime // 허위 개설 시 법적 책임 고지 동의 시각(§4.3-4)
  reportedAt          DateTime? // 신고 접수 시각 — 값이 있으면 자동 PRIVATE 전환(§4.3-3, §9.1-5)
  reviewedAt          DateTime? // 운영자 확인 시각
  closedAt            DateTime? // 개설자가 닫음 (소프트 삭제)

  createdAt DateTime @default(now()) // 개설 일시
  updatedAt DateTime @updatedAt // 최종 수정 일시

  tributes  MemorialTribute[] // 헌화 목록
  guestbook MemorialGuestbook[] // 방명록 목록
  photos    MemorialPhoto[] // 사진 앨범

  @@index([createdByUserId])
  @@index([visibility])
}

// 헌화(§4.4) — 비회원 허용, 로그인 사용자는 1인 1회 보장. IP는 원문 저장 금지, 해시만(§9.1-6).
model MemorialTribute {
  id          String   @id @default(uuid()) // 고유 식별자(UUID)
  memorialId  String // 헌화 대상 추모관
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  userId      String? // FK → User (비회원이면 null)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorHash String // 비회원 중복 억제용 해시(브라우저 토큰+IP 조합) — IP 원문 저장 금지(§4.4)
  createdAt   DateTime @default(now()) // 헌화 일시

  @@unique([memorialId, userId]) // 로그인 사용자 1인 1회 보장 (userId=null인 비회원 행은 유니크 제약 미적용)
}

// 방명록(§4.5) — 비회원 작성 허용, 작성자명은 스냅샷(01-05 §4.4 원칙 승계, §5.5).
model MemorialGuestbook {
  id                 String    @id @default(uuid()) // 고유 식별자(UUID)
  memorialId         String // 방명록 대상 추모관
  memorial           Memorial  @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  userId             String? // FK → User (비회원이면 null)
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName         String // 작성자명 스냅샷
  relationToDeceased String? // 고인과의 관계 (예: '친구')
  message            String // 본문
  deletedByOwnerAt   DateTime? // 상주가 삭제(§4.5) — 소프트 삭제
  hiddenAt           DateTime? // 운영자 강제 비공개 — 소프트 삭제로 원문 보존
  createdAt          DateTime  @default(now()) // 작성 일시

  @@index([memorialId, createdAt])
}

// 추모 사진(§4.6) — 업로드는 구현하되 실서비스 오픈은 오브젝트 스토리지 전환 이후로 묶는다
// (systems.md §5, §9.1-7). 업로드 상한 등 수치는 policy.ts에 둔다(01-05 §12).
model MemorialPhoto {
  id               String   @id @default(uuid()) // 고유 식별자(UUID)
  memorialId       String // 사진이 속한 추모관
  memorial         Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  uploadedByUserId String // FK → User — 업로드 권한은 개설자로 제한(초기)
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  url              String // 이미지 URL
  title            String // 사진 제목
  sortOrder        Int      @default(0) // 대표 사진은 sortOrder 최소값 (Facility.images[0] 규칙과 동일 사상)
  createdAt        DateTime @default(now()) // 등록 일시

  @@index([memorialId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────
// 운영자(내부 직원) 계정 — Partner/Expert와 인증 패턴은 같지만 **공개 가입 API가 없다.**
// 계정 생성은 시드 스크립트(prisma/seed-admin.ts)로만 한다 — 가입 폼을 공개하면
// 그 자체가 보안 구멍이 된다. 2026-08-10 신설 — 장사시설/전문가 가입 승인 + 시설 클레임 승인용.
// ─────────────────────────────────────────────────────────────────
model Admin {
  id               String  @id @default(uuid()) // 고유 식별자(UUID)
  email            String  @unique // 로그인 ID
  passwordHash     String // bcrypt 해시 (평문 저장 금지)
  refreshTokenHash String? // 발급된 refresh token의 sha256 해시 (회전·재사용 탐지용)
  name             String // 운영자 이름

  createdAt DateTime @default(now()) // 계정 생성 일시 (seed-admin.ts로만 생성됨)
  updatedAt DateTime @updatedAt // 최종 수정 일시
}
