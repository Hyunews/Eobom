PORT=5000
# 로그인 완료 후 돌려보낼 프론트 주소의 기본값(폴백)이다. LAN IP로 접속해 로그인한 경우
# (예: 폰으로 http://192.168.x.x:5173 접속) 백엔드가 요청 Referer로 그 주소를 자동 감지해
# 이 값 대신 사용한다 — 사설 IP·localhost + 5173 포트만 신뢰하며, 그 외(배포 도메인 등)는
# 항상 이 FRONTEND_URL 값을 쓴다. 프로덕션에서는 실제 배포 주소로 반드시 채울 것.
FRONTEND_URL=http://localhost:5173
JWT_SECRET=eobom_jwt_secret_key_2026_well_dying
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eobom_db?schema=public"

# Partner(사업자) 정산 계좌 등 민감 필드 암호화 키(AES-256-GCM). 임의 길이 문자열 가능(sha256으로 정규화됨).
# 운영 배포 시 반드시 새로 생성해서 교체할 것 — 이 값이 유출되면 저장된 정산 계좌 전부 복호화 가능.
SETTLEMENT_ENCRYPTION_KEY=change_this_to_a_long_random_string_in_each_environment

# 06(엔딩노트·유족 메시지) 전용 암호화 키(AES-256-GCM). 정산 계좌 키와 분리한다(06-04 §13 #4)
# — 정산 계좌와 같은 키를 쓰면 한쪽 유출이 곧 양쪽 유출이 된다. SETTLEMENT_ENCRYPTION_KEY와 같은
# 방식으로 임의 길이 문자열이면 되고 sha256으로 정규화된다.
# 🔴 로컬과 운영에 서로 다른 값을 넣을 것. 🔴 운영 키를 잃으면 유언·편지를 영영 복호화할 수 없다.
ENDING_NOTE_ENCRYPTION_KEY=change_this_to_a_long_random_string_in_each_environment

# 운영 DB 백업 전용(.harness/tools/backup-db.ps1) — DIRECT_URL과 별개로 둔다. DIRECT_URL은
# 로컬 Docker DB를 가리키므로 이 값이 없으면 운영 DB를 백업할 방법이 없다.
# 🔴 Supabase Session pooler(5432)여야 한다 — Direct(db.[ref].supabase.co)는 IPv6 전용이라
#    Docker에서 해석 실패하고, Transaction(:6543)은 pg_dump가 실패한다.
# 유저명은 postgres.[project-ref] 형태. 자세한 함정은 systems.md §4.
BACKUP_DATABASE_URL=

# OAuth 콜백 URL은 https다 — 2026-08-07 mkcert 도입 후 백엔드가 인증서 존재 시 HTTPS만 서빙한다
# (server.ts). http로 두면 카카오 인증 완료 후 리다이렉트가 TLS 포트에 평문으로 들어가 빈 응답
# (ERR_EMPTY_RESPONSE)이 난다 — 2026-08-10 실제 장애. 이 값과 각 OAuth 콘솔에 등록된 Redirect URI가
# 정확히 일치해야 한다(→ .harness/systems.md §1).

# Kakao OAuth
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_CALLBACK_URL=https://localhost:5000/api/auth/kakao/callback

# Naver OAuth
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=https://localhost:5000/api/auth/naver/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://localhost:5000/api/auth/google/callback

# STT Ⓐ 파일 업로드 — NCP CLOVA Speech(장문 인식, docs 06-04 §6.4-11). Invoke URL이 도메인
# 식별자를 이미 품고 있어 별도 Client ID가 없다 — 인증은 Secret Key 헤더 하나로 한다.
CLOVA_SPEECH_INVOKE_URL=https://clovaspeech-gw.ncloud.com/external/v1/your-domain-id
CLOVA_SPEECH_SECRET=your_clova_speech_secret_key
# 기능 플래그. 기본값은 반드시 false — 배선은 켜두되(§6.4-9-8-3), ⓐ이용자 동의화면·
# ⓑprovider 교체·ⓒ계약 중 하나가 서기 전에는 실사용자에게 업로드 버튼을 노출하지 않는다.
CLOVA_STT_ENABLED=false
